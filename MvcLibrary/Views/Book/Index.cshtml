@model FilterViewModel<Book>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
@if (HttpContextAccessor.HttpContext.Session.GetInt32("_userType") == 1)
{
    <p>
        <a class="btn-outline-primary" asp-action="Create">Create New</a>
    </p>
}
<form asp-controller="Book" asp-action="Index">
    <p>
        <select name="bookCategory" asp-items="Model.SelectListItems">
            <option value="">All</option>
        </select>
        <label>Title: <input type="text" asp-for="SearchString" value="@Model.SearchString" /></label>
        <input type="submit" value="Filter" />
    </p>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].CategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].Year)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].IsAvailable)
            </th>
            @if (HttpContextAccessor.HttpContext.Session.GetInt32("_userType") == 1)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Author)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Year)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsAvailable)
                </td>
                @if (HttpContextAccessor.HttpContext.Session.GetInt32("_userType") == 1)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
